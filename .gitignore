# Track only scripts/, configs/, the annotation labels and the exclusion list (plus this file).
/*
!/.gitignore
!/scripts/
!/configs/

# From data/, track only the small text files that record annotation decisions.
!/data/
/data/*
!/data/excluded_frames.csv
!/data/labels_yolo/
/data/labels_yolo/*
!/data/labels_yolo/*.txt

# Explicitly never tracked
runs/
results/
.venv/
venv/
__pycache__/
*.pyc
*.pt
*.pth
