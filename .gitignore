# Track only: scripts/, configs/, CLAUDE.md, annotation text files, and the
# text records in results/ (config_log.md, requirements_freeze.txt and all .csv). Everything else is ignored.
/*
!/.gitignore
!/CLAUDE.md
!/scripts/
!/configs/

# From data/, track only the small text files that record annotation decisions.
!/data/
/data/*
!/data/excluded_frames.csv
!/data/reviewed_labels.csv
!/data/exclusion_candidates.csv
!/data/preannot_report.csv
!/data/labels_auto/
/data/labels_auto/*
!/data/labels_auto/*.txt
!/data/labels_yolo/
/data/labels_yolo/*
!/data/labels_yolo/*.txt

# From results/, track only config_log.md and .csv files (any subfolder);
# images, contact sheets and HTML stay untracked.
!/results/
/results/**
!/results/**/
!/results/config_log.md
!/results/requirements_freeze.txt
!/results/**/*.csv

# Explicitly never tracked
runs/
.venv/
venv/
__pycache__/
*.pyc
*.pt
*.pth
